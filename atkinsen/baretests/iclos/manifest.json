{
    "name": "iclOS Research Program",
    "short_name": "iclOS",
    "description": "HNet At The Atkinsen Institute Project On DOS Development (Newer Stream)",
    "start_url": "./",
    "scope": "./",
    "theme_color": "#000000",
    "background_color": "#000000",
    "display": "fullscreen",
    "display_override": ["window-controls-overlay", "standalone"],
    "icons": [
        {
            "src": "512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "maskable"
        },
        {
            "src": "512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "any"
        }
    ],

    "launch_handler": {
        "client_mode": "navigate-new"
    },
    "file_handlers": [
        {
            "action": "/?open-file=true",
            "accept": {
            "image/png": [".png"],
            "text/*": [".txt"]
            }
        }
    ],
    "share_target": {
        "action": "/",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "__share_target__title",
            "text": "__share_target__text",
            "url": "__share_target__url"
        }
    }
}
